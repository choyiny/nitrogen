{
  "name": "nitrogen",
  "version": "1.0.0",
  "description": "Carbon.now.sh for AI coding — turn Claude Code, Codex, and Gemini CLI sessions into shareable terminal snippet images.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/choyiny/nitrogen.git"
  },
  "keywords": [
    "claude-code",
    "codex",
    "gemini",
    "terminal",
    "screenshot",
    "carbon",
    "developer-tools",
    "react",
    "vite"
  ],
  "author": "Cho Yin Yong",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/choyiny/nitrogen/issues"
  },
  "homepage": "https://nitrogen.cite-met.dev",
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "dompurify": "^3.4.13",
    "html-to-image": "^1.11.13",
    "marked": "^18.0.9",
    "pako": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/dompurify": "^3.2.0",
    "@types/pako": "^3.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
